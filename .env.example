# Placeholder configuration. Copy to .env; never commit actual local values.
DOCKER_CONTEXT=colima
SENTRY_ORG_SLUG=your-org-slug
SENTRY_TEAM_SLUG=your-team-slug
SENTRY_BASE_URL=https://sentry.io
SENTRY_EXPORTER_MODE=sentry
# Only routine Redis/PostgreSQL logs: 5, 10 or 100. App logs and incident logs stay at 100%.
OTEL_INFRA_LOG_SAMPLE_PERCENT=5
SENTRY_AUTH_TOKEN=
SENTRY_SOURCE_MAP_AUTH_TOKEN=
SENTRY_DSN_WEB=
SENTRY_DSN_CATALOG=
SENTRY_DSN_FULFILLMENT=
SENTRY_DSN_WORKER=
SENTRY_DSN_INFRASTRUCTURE=
WORKSHOP_SESSION_ID=local-workshop
WORKSHOP_ENVIRONMENT=workshop-local
# Strict default; for delayed telemetry visibility during rehearsal, override to 300.
WORKSHOP_VERIFICATION_TIMEOUT_SECONDS=120
POSTGRES_PASSWORD=replace-with-local-password
CATALOG_DB_PASSWORD=replace-with-local-password
FULFILLMENT_DB_PASSWORD=replace-with-local-password
REDIS_PASSWORD=replace-with-local-password
