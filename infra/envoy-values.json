{
  "config": {
    "envoyGateway": {
      "provider": {
        "type": "Kubernetes",
        "kubernetes": {
          "deploy": {
            "type": "GatewayNamespace"
          }
        }
      }
    }
  },
  "deployment": {
    "envoyGateway": {
      "resources": {
        "requests": {
          "cpu": "100m",
          "memory": "128Mi"
        },
        "limits": {
          "memory": "512Mi"
        }
      }
    }
  },
  "global": {
    "images": {
      "envoyGateway": {
        "image": "docker.io/envoyproxy/gateway:v1.9.2@sha256:9d67017c442a70e6ae9f1a358e6c80eb653c67c2e40823d9a991e0daf37ba926"
      },
      "envoyProxy": {
        "image": "docker.io/envoyproxy/envoy:distroless-v1.39.1@sha256:eb2c01c13125d1629637cb4e4cce7207009fb7cc2c8027f9742758549d15b6f4"
      }
    }
  }
}
