{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "otel-gateway-data",
        "namespace": "observability",
        "labels": {
          "app.kubernetes.io/name": "otel-gateway-data",
          "app.kubernetes.io/part-of": "sentry-otel-workshop"
        }
      },
      "spec": {
        "storageClassName": "standard",
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "1Gi"
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "DaemonSet",
      "metadata": {
        "name": "otel-agent",
        "namespace": "observability",
        "labels": {
          "app.kubernetes.io/name": "otel-agent",
          "app.kubernetes.io/part-of": "sentry-otel-workshop"
        }
      },
      "spec": {
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "otel-agent"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "otel-agent",
              "app.kubernetes.io/part-of": "sentry-otel-workshop"
            }
          },
          "spec": {
            "automountServiceAccountToken": true,
            "serviceAccountName": "otel-agent",
            "securityContext": {
              "fsGroup": 10001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "collector",
                "image": "otel/opentelemetry-collector-contrib:0.162.0@sha256:39923a8e431bd1f57be82411999d389fcfe40857492e4365456d97a4c1f74be6",
                "args": [
                  "--config=/etc/otel/config.yaml"
                ],
                "ports": [
                  {
                    "containerPort": 4317,
                    "name": "grpc"
                  },
                  {
                    "containerPort": 4318,
                    "name": "http"
                  },
                  {
                    "containerPort": 13133,
                    "name": "health"
                  }
                ],
                "env": [
                  {
                    "name": "NODE_NAME",
                    "valueFrom": {
                      "fieldRef": {
                        "fieldPath": "spec.nodeName"
                      }
                    }
                  },
                  {
                    "name": "WORKSHOP_SESSION_ID",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "workshop-secrets",
                        "key": "WORKSHOP_SESSION_ID"
                      }
                    }
                  },
                  {
                    "name": "WORKSHOP_ENVIRONMENT",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "workshop-secrets",
                        "key": "WORKSHOP_ENVIRONMENT"
                      }
                    }
                  },
                  {
                    "name": "SERVICE_VERSION",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "workshop-secrets",
                        "key": "SERVICE_VERSION"
                      }
                    }
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "1000m",
                    "memory": "256Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/etc/otel",
                    "readOnly": true
                  },
                  {
                    "name": "data",
                    "mountPath": "/var/lib/otelcol"
                  },
                  {
                    "name": "logs",
                    "mountPath": "/var/log/pods",
                    "readOnly": true
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/",
                    "port": 13133
                  }
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/",
                    "port": 13133
                  },
                  "initialDelaySeconds": 10
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "runAsUser": 0
                }
              }
            ],
            "volumes": [
              {
                "name": "config",
                "configMap": {
                  "name": "otel-agent-config"
                }
              },
              {
                "name": "data",
                "hostPath": {
                  "path": "/var/lib/workshop-otel-agent",
                  "type": "DirectoryOrCreate"
                }
              },
              {
                "name": "logs",
                "hostPath": {
                  "path": "/var/log/pods",
                  "type": "Directory"
                }
              }
            ],
            "tolerations": [
              {
                "key": "node-role.kubernetes.io/control-plane",
                "operator": "Exists",
                "effect": "NoSchedule"
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "otel-agent",
        "namespace": "observability",
        "labels": {
          "app.kubernetes.io/name": "otel-agent",
          "app.kubernetes.io/part-of": "sentry-otel-workshop"
        }
      },
      "spec": {
        "selector": {
          "app.kubernetes.io/name": "otel-agent"
        },
        "ports": [
          {
            "name": "grpc",
            "port": 4317,
            "targetPort": 4317
          },
          {
            "name": "http",
            "port": 4318,
            "targetPort": 4318
          }
        ],
        "internalTrafficPolicy": "Local"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "otel-gateway",
        "namespace": "observability",
        "labels": {
          "app.kubernetes.io/name": "otel-gateway",
          "app.kubernetes.io/part-of": "sentry-otel-workshop"
        }
      },
      "spec": {
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "otel-gateway"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "otel-gateway",
              "app.kubernetes.io/part-of": "sentry-otel-workshop"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "serviceAccountName": "default",
            "securityContext": {
              "fsGroup": 10001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "collector",
                "image": "otel/opentelemetry-collector-contrib:0.162.0@sha256:39923a8e431bd1f57be82411999d389fcfe40857492e4365456d97a4c1f74be6",
                "args": [
                  "--config=/etc/otel/config.yaml"
                ],
                "ports": [
                  {
                    "containerPort": 4317,
                    "name": "grpc"
                  },
                  {
                    "containerPort": 4318,
                    "name": "http"
                  },
                  {
                    "containerPort": 13133,
                    "name": "health"
                  }
                ],
                "env": [
                  {
                    "name": "NODE_NAME",
                    "valueFrom": {
                      "fieldRef": {
                        "fieldPath": "spec.nodeName"
                      }
                    }
                  },
                  {
                    "name": "WORKSHOP_SESSION_ID",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "workshop-secrets",
                        "key": "WORKSHOP_SESSION_ID"
                      }
                    }
                  },
                  {
                    "name": "WORKSHOP_ENVIRONMENT",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "workshop-secrets",
                        "key": "WORKSHOP_ENVIRONMENT"
                      }
                    }
                  },
                  {
                    "name": "SERVICE_VERSION",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "workshop-secrets",
                        "key": "SERVICE_VERSION"
                      }
                    }
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "cpu": "1000m",
                    "memory": "512Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/etc/otel",
                    "readOnly": true
                  },
                  {
                    "name": "data",
                    "mountPath": "/var/lib/otelcol"
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/",
                    "port": 13133
                  }
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/",
                    "port": 13133
                  },
                  "initialDelaySeconds": 10
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "runAsUser": 10001
                },
                "envFrom": [
                  {
                    "secretRef": {
                      "name": "workshop-secrets"
                    }
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "config",
                "configMap": {
                  "name": "otel-gateway-config"
                }
              },
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "otel-gateway-data"
                }
              }
            ]
          }
        },
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "otel-gateway",
        "namespace": "observability",
        "labels": {
          "app.kubernetes.io/name": "otel-gateway",
          "app.kubernetes.io/part-of": "sentry-otel-workshop"
        }
      },
      "spec": {
        "selector": {
          "app.kubernetes.io/name": "otel-gateway"
        },
        "ports": [
          {
            "name": "grpc",
            "port": 4317,
            "targetPort": 4317
          },
          {
            "name": "http",
            "port": 4318,
            "targetPort": 4318
          }
        ]
      }
    }
  ]
}
